# Application
APP_ENV=development
LOG_LEVEL=INFO

# Explicit HTTPS archive URL copied from the official catalogue's Pobierz link:
# https://open-data.cui.wroclaw.pl/hdb/ft/6/
# No automatic latest selection. --url takes precedence over GTFS_URL.
# This file is documentation only: set $env:GTFS_URL in PowerShell.
GTFS_URL=

# Compose interpolation only: fill both passwords locally before docker compose.
# No defaults/trust auth. Existing volumes retain their original credentials.
POSTGRES_PASSWORD=
WTA_LOADER_PASSWORD=
POSTGRES_PORT=5433
# Windows forward slashes are accepted. Mount the entire silver root read-only.
SILVER_DIR=C:/projekty/wroclaw-transit-analytics/data/silver

# Python does not load .env. Export these separately in PowerShell.
# Password is supplied via $env:PGPASSWORD; alternatively use a correctly escaped DSN.
DATABASE_URL=host=127.0.0.1 port=5433 dbname=wta user=wta_loader
PGPASSWORD=
# Integration tests require a separately provisioned disposable wta_test* database.
TEST_DATABASE_URL=
