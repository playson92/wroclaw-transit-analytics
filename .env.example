# Application
APP_ENV=development
LOG_LEVEL=INFO

# Explicit HTTPS archive URL copied from the official catalogue's Pobierz link:
# https://open-data.cui.wroclaw.pl/hdb/ft/6/
# No automatic latest selection. --url takes precedence over GTFS_URL.
# This file is documentation only: set $env:GTFS_URL in PowerShell.
GTFS_URL=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=portfolio
DATABASE_USER=portfolio_user
DATABASE_PASSWORD=change_me

# Optional warehouse backend
WAREHOUSE_BACKEND=postgres
